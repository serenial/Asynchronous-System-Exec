# SOURCE THE CROSS COMPILE ENVIRONMENTAL FILE FIRST! #

import os ;
local SDKTARGETSYSROOT = [ os.environ SDKTARGETSYSROOT ] ;
local OECORE_NATIVE_SYSROOT = [ os.environ OECORE_NATIVE_SYSROOT ] ;


# ------------------
# GCC configuration.
# ------------------

# Specify the cross compile tools - values taken from cross-compiler's environemental setup script


using gcc 
	: x86_64_nilrt 
	: $(OECORE_NATIVE_SYSROOT)/usr/bin/x86_64-nilrt-linux/x86_64-nilrt-linux-g++
	: <compileflags>-m64 <compileflags>-march=core2 <compileflags>-mtune=core2 <compileflags>-msse3 <compileflags>-mfpmath=sse <compileflags>--sysroot=$(SDKTARGETSYSROOT) <linkflags>--sysroot=$(SDKTARGETSYSROOT) 
	;
