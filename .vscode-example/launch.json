{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Windows MSVC",
            "type": "cppvsdbg",
            "request": "attach",
            "program": "C:/Program Files (x86)/National Instruments/LabVIEW 2020/LabVIEW.exe",
            "processId":"${command:pickProcess}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "Debug Linux GDB",
            "type": "cppdbg",
            "request": "attach",
            "program": "/usr/local/natinst/LabVIEW-2020-64/labview",
            "processId":"${command:pickProcess}",
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing"
                }
            ],
            "additionalSOLibSearchPath": "${workspaceDirectory}/LabVIEW/serenial.io-ase/ase"
        }
    ]
}